{
  "worktree": {
    "root": "../{repo}-wt",
    "folderPattern": "{slug}"
  },
  "docker": {
    "enabled": false,
    "composeFile": "docker-compose.yml",
    "projectNamePattern": "{repoSlug}_{slug}",
    "portBase": 3000,
    "portsPerSpec": 10,
    "envFile": ".env",
    "backupCommand": ""
  },
  "setup": [
    "pnpm install --frozen-lockfile"
  ],
  "open": {
    "command": ""
  },
  "registry": ".spec-env/registry.json",
  "linkLinear": false,
  "guards": {
    "refuseTeardownIfDirty": true,
    "refuseTeardownIfUnpushed": true
  },
  "branch": {
    "pattern": "{type}/{slug}",
    "identifierField": "linear_identifier"
  },
  "spec": {
    "companionPaths": [
      "specs/.core/linear-base/{identifier}.base.json"
    ]
  }
}
