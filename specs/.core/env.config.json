{
  "worktree": {
    "root": "../{repo}-wt",
    "folderPattern": "{slug}"
  },
  "setup": [
    "pnpm install --frozen-lockfile"
  ],
  "registry": ".spec-env/registry.json",
  "guards": {
    "refuseTeardownIfDirty": true,
    "refuseTeardownIfUnpushed": true
  },
  "branch": {
    "pattern": "{type}/{slug}",
    "identifierField": "github_identifier"
  },
  "spec": {
    "companionPaths": [
      "specs/.core/github-base/{identifier}.base.json"
    ]
  },
  "complete": {
    "checks": [
      "node scripts/docs-freshness.js impact"
    ]
  }
}
