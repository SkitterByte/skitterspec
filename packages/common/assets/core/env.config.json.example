{
  "mode": "worktree",
  "project": {
    "name": "",
    "category": ""
  },
  "worktree": {
    "root": "../{repo}-wt",
    "folderPattern": "{slug}"
  },
  "ports": {
    "base": 3000,
    "perSpec": 10
  },
  "seedFiles": {
    "mode": "symlink",
    "files": [
      ".env"
    ]
  },
  "setup": [],
  "dev": [],
  "registry": ".spec-env/registry.json",
  "branch": {
    "pattern": "{type}/{slug}",
    "identifierField": ""
  },
  "spec": {
    "companionPaths": []
  },
  "baseBranch": "",
  "baseBranchPattern": "",
  "guards": {
    "refuseTeardownIfDirty": true,
    "refuseTeardownIfUnpushed": true
  },
  "review": {
    "reader": "detect",
    "servePort": "auto",
    "serve": "always",
    "allowNetwork": true,
    "commitWith": "/commit",
    "required": true,
    "projectName": "",
    "reviewers": []
  },
  "auto": {
    "default": "supervised",
    "then": "pause",
    "maxFixAttempts": 3
  },
  "live": {
    "migrations": []
  }
}
